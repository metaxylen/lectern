{
  "name": "lectern",
  "version": "0.3.0",
  "private": true,
  "description": "Local-first lecture transcription and study notes: record or upload, get a timestamped transcript, chapters, exam notes and flashcards. Mixed English and Turkish.",
  "license": "MIT",
  "homepage": "https://github.com/metaxylen/lectern#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metaxylen/lectern.git"
  },
  "bugs": {
    "url": "https://github.com/metaxylen/lectern/issues"
  },
  "keywords": [
    "speech-to-text",
    "whisper",
    "transcription",
    "lecture",
    "notes",
    "study",
    "ollama",
    "nextjs",
    "local-first",
    "turkish",
    "webgpu"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 47231 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 47231 -H 0.0.0.0",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "eval": "vitest run --config vitest.eval.config.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@huggingface/transformers": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10",
    "eslint-config-next": "16.3.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
