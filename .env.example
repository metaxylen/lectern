# All optional. The app works with none of these set.

# Ollama (local LLM for notes). Defaults shown.
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# Google Gemini free tier (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Length of each audio chunk sent to Whisper (seconds). Short chunks let a Turkish
# sentence be language-detected on its own. Sensible range: 15-30.
# NEXT_PUBLIC_CHUNK_SECONDS=20

# --- API hardening (server) ---
# Max transcript characters accepted by /api/notes (default 500000).
# NOTES_MAX_TRANSCRIPT_CHARS=500000
# Requests per minute per client for /api/notes; 0 disables limiting (default 20).
# NOTES_RATE_LIMIT_PER_MINUTE=20

# --- Error reporting (optional) ---
# Errors are always logged. If set, each unique error is also POSTed here as JSON
# (see lib/monitoring.ts for the payload shape).
# NEXT_PUBLIC_ERROR_REPORT_URL=
